# =============================================================================
# HelpDev API — Liara (helpdevapi) environment template (EXAMPLE ONLY)
# =============================================================================
# Copy values into Liara Console → helpdevapi → تنظیمات → متغیرها
# or: liara env:set KEY=VALUE -a helpdevapi
#
# Never commit real credentials. Jwt__Secret and Security__PartitionHashKey
# MUST be different, each at least 32 characters, and must NOT contain:
# secret, password, changeme, test, replace-me, change_in_production
# =============================================================================

ASPNETCORE_ENVIRONMENT=Production

# PostgreSQL from Liara DBaaS (شبکه خصوصی). Replace with the real URI from
# the database page. Do not use the public URI if the app and DB are on Liara.
ConnectionStrings__DefaultConnection=Host=<postgres-host>;Port=5432;Database=helpdev;Username=<user>;Password=<password>;SSL Mode=Prefer;Trust Server Certificate=true

# Generate two different random strings (≥ 32 chars). Do not reuse localhost values.
Jwt__Secret=<generate-unique-32plus-chars>
Security__PartitionHashKey=<generate-a-different-32plus-chars>

# First boot: apply schema. After the first healthy deploy, switch to Validate.
Database__MigrationMode=Apply
Database__SeedMode=None

# Persistent media disk mounted by api/liara.json.
Media__LocalStorageRoot=/data/media/uploads

# Liara terminates HTTPS and forwards HTTP. Trust private Docker networks so
# X-Forwarded-Proto is honored (avoids redirect loops and JWT HTTPS checks).
Security__TrustedProxyNetworks__0=10.0.0.0/8
Security__TrustedProxyNetworks__1=172.16.0.0/12
Security__TrustedProxyNetworks__2=192.168.0.0/16

# Optional: public frontend origin. localhost is already allowed for local site.
# Cors__FrontendOrigins__0=https://your-frontend.example.com
