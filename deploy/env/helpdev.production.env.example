# =============================================================================
# HelpDev API - Production environment template (EXAMPLE ONLY)
# =============================================================================
# Copy this file to a secure location (NOT the repository) and replace every
# <placeholder> with a real value injected by your host's secret mechanism.
#
# RULES:
#   - This file contains placeholders only. Never commit real credentials.
#   - Secrets must be injected by the host (systemd EnvironmentFile, container
#     secret store, or an external secret provider), not stored in the repo.
#   - Jwt__Secret and Security__PartitionHashKey MUST be different values.
#   - Both secrets MUST be at least 32 characters.
#   - Never enable a deterministic OTP provider in Production.
# =============================================================================

# ---- Hosting ----------------------------------------------------------------
# ASP.NET Core environment. Must be Production for production hardening rules.
ASPNETCORE_ENVIRONMENT=Production
# Internal bind address. The reverse proxy terminates TLS and forwards to this.
ASPNETCORE_URLS=http://0.0.0.0:8080

# ---- Database ---------------------------------------------------------------
# PostgreSQL connection string. Injected securely; never logged.
ConnectionStrings__DefaultConnection=<set-securely>

# ---- Authentication (JWT) ---------------------------------------------------
# Signing key for issued JWTs. Minimum 32 characters. Distinct from the
# partition key below.
Jwt__Secret=<minimum-32-character-secret>
Jwt__Issuer=<issuer>
Jwt__Audience=<audience>

# ---- Security ---------------------------------------------------------------
# HMAC key used to partition rate-limit buckets. MUST differ from Jwt__Secret
# and be at least 32 characters.
Security__PartitionHashKey=<different-minimum-32-character-secret>
# Reject tokens without HTTPS metadata. Must remain true in Production.
Security__RequireHttpsMetadata=true

# ---- CORS -------------------------------------------------------------------
# Exact allowed browser origin(s) for the frontend. HTTPS only in Production.
# No wildcards. Add more with __1, __2, ... if you serve multiple origins.
Cors__AllowedOrigins__0=https://frontend.example.com

# ---- Reverse proxy / forwarded headers --------------------------------------
# Enable only when running behind a trusted reverse proxy that terminates TLS.
ForwardedHeaders__Enabled=true
# The proxy address(es) permitted to set X-Forwarded-* headers.
ForwardedHeaders__TrustedProxyAddresses__0=<proxy-ip>
# Number of proxies between the client and the app (usually 1).
ForwardedHeaders__ForwardLimit=1

# ---- HTTPS / HSTS -----------------------------------------------------------
Https__EnableRedirection=true
Https__EnableHsts=true

# ---- Database startup policy ------------------------------------------------
# Normal startup validates schema and blocks on pending migrations.
# Use the controlled --apply-migrations command to apply migrations.
Database__MigrationMode=Validate
# Do not seed demo data in Production.
Database__SeedMode=None

# ---- Outbox -----------------------------------------------------------------
Outbox__Enabled=true

# ---- OpenAPI ----------------------------------------------------------------
# OpenAPI/Swagger is disabled in Production.
OpenApi__EnableInProduction=false
OpenApi__ExposeAdminDocumentInProduction=false
OpenApi__EnableTryItOutInProduction=false

# ---- Release metadata (Admin-only, sanitized) -------------------------------
# Surfaced by /api/v1/admin/operations/version and the release manifest.
RELEASE_VERSION=<version>
RELEASE_COMMIT=<commit>
RELEASE_BUILD_TIMESTAMP=<utc-timestamp>
RELEASE_CHANNEL=production
