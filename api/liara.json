{
  "app": "helpdevapi",
  "port": 80,
  "platform": "dotnet",
  "dotnet": {
    "version": "8.0",
    "timezone": "Asia/Tehran",
    "finalDllName": "HelpDev.API",
    "csprojectFile": "src/HelpDev.API/HelpDev.API.csproj"
  },
  "disks": [
    {
      "name": "media",
      "mountTo": "/data/media"
    }
  ],
  "healthCheck": {
    "command": "CMD curl --fail http://127.0.0.1:80/health/live || exit 1",
    "interval": 30000,
    "timeout": 15000,
    "retries": 5,
    "startPeriod": 120000
  }
}
