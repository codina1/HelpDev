{
  "OpenApi": {
    "Enabled": true,
    "EnableUi": false,
    "EnableInProduction": false,
    "ExposePublicDocument": true,
    "ExposeAuthenticatedDocument": true,
    "ExposeAdminDocument": true,
    "ExposeCompleteDocument": true,
    "ExportDirectory": "artifacts/openapi"
  },
  "RateLimiting": {
    "General": {
      "PermitLimit": 2,
      "WindowSeconds": 10,
      "QueueLimit": 0
    },
    "OtpRequest": {
      "PermitLimit": 2,
      "WindowSeconds": 10,
      "QueueLimit": 0
    },
    "OtpRequestNetwork": {
      "PermitLimit": 2,
      "WindowSeconds": 10,
      "QueueLimit": 0
    }
  },
  "Observability": {
    "GlobalTimeoutSeconds": 30,
    "PostgreSql": {
      "TimeoutSeconds": 10
    },
    "Outbox": {
      "ProcessorStaleMinutes": 10080,
      "WarningDeadLetterCount": 10000
    }
  },
  "Ai": {
    "Enabled": true,
    "ProviderName": "Fake",
    "Model": "fake-v1",
    "AllowedTasks": "ContentAnalysis,TitleSuggestion,MetaDescription,OutlineGeneration,FaqGeneration",
    "DefaultMaxTokens": 1024
  },
  "Embedding": {
    "Enabled": true,
    "ProviderName": "Fake",
    "Model": "fake-embed-v1",
    "Dimensions": 384
  }
}
